# 이 파일은 git에 올린다. 실제 값이 든 .env는 올리지 않는다.
# 처음 받은 사람은:  cp .env.example .env

# --- 앱 ---
APP_ENV=local
DEBUG=true

# --- DB (Week 2부터) ---
# docker compose의 db 서비스와 계정/DB 이름이 맞아야 한다
DATABASE_URL=postgresql+asyncpg://harulog:harulog@localhost:5432/harulog

# --- Redis (Week 4부터) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (Week 1) ---
# "*" 를 쓰지 않는다. 허용할 주소를 하나씩 적는다
CORS_ORIGINS=["http://localhost:3000"]

# --- 토큰 (Week 4) ---
# 실제 값은 각자 생성:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- 메일 (Week 5, MailHog) ---
SMTP_HOST=localhost
SMTP_PORT=1025
